<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- Debug builds only: export the cast foreground service so it can be
             smoke-tested from adb shell (am start-foreground-service). Release
             builds keep android:exported="false" from the main manifest. -->
        <service
            android:name=".CastForegroundService"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
